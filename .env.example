# Supabase — Project Settings → API Keys
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Server only. Never expose this to the browser. Used to resolve usernames at
# login and, later, for the super admin to create admin accounts.
SUPABASE_SECRET_KEY=sb_secret_...

# Initial password for the division super admin accounts, used only by
# `pnpm seed:super-admins`. Kept out of git on purpose.
SEED_SUPER_ADMIN_PASSWORD=

# Signs the rotating token inside the presensi QR. Any long random string; it
# only has to stay the same across the servers of one deployment. Changing it
# invalidates every QR on screen at that moment. Falls back to
# SUPABASE_SECRET_KEY when unset.
PRESENSI_TOKEN_SECRET=
