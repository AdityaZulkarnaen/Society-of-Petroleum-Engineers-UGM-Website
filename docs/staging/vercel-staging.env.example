# ==============================================================================
# SPE UGM SC Recruitment Backend — Dedicated Vercel Staging Environment Template
# ==============================================================================
#
# INSTRUCTIONS FOR COLLABORATOR (ADIT):
# 1. Do NOT commit real secrets or credentials to Git.
# 2. Configure these variables in the Vercel Dashboard under:
#    Project Settings -> Environment Variables -> Production & Preview.
# 3. Enable "Automatically expose System Environment Variables" in Project Settings
#    so that Vercel provides VERCEL_PROJECT_ID at runtime.
# 4. NEVER copy values from the production website (www.speugmsc.org).
#
# ==============================================================================
# 1. RECRUITMENT FEATURE TOGGLE
# ==============================================================================
# Activates the recruitment application module. Fails closed (HTTP 503) if false or unset.
RECRUITMENT_ENABLED=true

# ==============================================================================
# 2. VERCEL PROJECT IDENTITY & ISOLATION GUARDS (B6F)
# ==============================================================================
# Adit must retrieve the Project ID from:
# Vercel Project -> Settings -> General -> "Project ID" (starts with prj_...)
# This expected ID is matched against the runtime VERCEL_PROJECT_ID system variable.
# If they do not match, the application immediately aborts with HTTP 503.
VERCEL_STAGING_PROJECT_ID=prj_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# NOTE: Do NOT manually create VERCEL_PROJECT_ID in the dashboard.
# It is injected automatically by Vercel when "System Environment Variables" are exposed.

# ==============================================================================
# 3. SUPABASE STAGING DATABASE (lavxddhrrwsjcshmnwvu)
# ==============================================================================
# MUST point to the authorized Supabase staging project. Connecting to production
# or non-staging Supabase projects from staging will fail closed at runtime.
NEXT_PUBLIC_SUPABASE_URL=https://lavxddhrrwsjcshmnwvu.supabase.co

# Matching Staging Anon / Publishable Key (safe for client bundle)
# CRITICAL: src/lib/supabase/env.ts requires NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY for
# middleware proxy, admin login, and browser client. Set both for maximum compatibility.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Staging Supabase Service Role Secret Key (SERVER-SIDE ONLY - NEVER EXPOSE TO CLIENT)
# Copy ONLY from .env.staging.private/recruitment-backend.env or staging Supabase dashboard.
# NEVER USE PRODUCTION SERVICE ROLE KEY.
SUPABASE_SECRET_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ==============================================================================
# 4. CANONICAL STAGING ORIGIN (CSRF & CORS PROTECTION)
# ==============================================================================
# The exact HTTPS canonical domain of your dedicated Vercel staging deployment.
# Must NOT include trailing slashes.
# Staging guards strictly PROHIBIT "https://www.speugmsc.org" or "https://speugmsc.org".
RECRUITMENT_ORIGIN=https://spe-recruitment-staging.vercel.app

# ==============================================================================
# 5. RECRUITMENT SESSION & PERIOD CONFIGURATION
# ==============================================================================
# Active recruitment period UUID in Supabase staging database.
RECRUITMENT_PERIOD_ID=87e7c760-1fb2-4e61-a803-b82a41b7847c

# Secret used to sign session cookies. MUST be at least 32 characters long.
# Generate a new random secret (e.g. `openssl rand -base64 32`).
RECRUITMENT_SESSION_SECRET=generate-a-secure-random-secret-key-at-least-32-chars

# ==============================================================================
# 6. DISTRIBUTED RATE LIMITING & CONCURRENCY LOCK (UPSTASH REDIS)
# ==============================================================================
# Mandatory for Vercel Serverless multi-instance architecture.
# In-memory limiter (RECRUITMENT_SINGLE_INSTANCE=true) is STRICTLY PROHIBITED on Vercel.
RECRUITMENT_DISTRIBUTED_LIMITER=upstash

# REST credentials for the Upstash Redis staging database.
# SERVER-SIDE ONLY: Never prefix with NEXT_PUBLIC_.
UPSTASH_REDIS_REST_URL=https://xxxxxxxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=Axxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx=

# Optional rate limiter tuning (defaults will apply if omitted):
# RECRUITMENT_LIMIT_SESSION_IP=60      # max session requests per IP per minute
# RECRUITMENT_LIMIT_SESSION_GLOBAL=300  # max session requests globally per minute
# RECRUITMENT_LIMIT_SUBMIT_IP=15        # max submission writes per IP per minute
# RECRUITMENT_LIMIT_SUBMIT_GLOBAL=120   # max submission writes globally per minute
# RECRUITMENT_LIMIT_SUBMIT_SESSION=10   # max submission writes per session token per minute

# ==============================================================================
# 7. PROHIBITED VARIABLES ON VERCEL STAGING
# ==============================================================================
# The following must NEVER be set on Vercel:
# RECRUITMENT_SINGLE_INSTANCE=true  -> Throws HTTP 503 on Vercel.
# ==============================================================================
